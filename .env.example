# Copiar a .env y completar. No guardar valores reales en Git.

# URL pública base (con https en producción). Se usa para construir los enlaces de invitación
# y como origen permitido en las solicitudes POST públicas.
APP_BASE_URL=http://localhost:3000

# Archivo JSON de invitados. En producción debe estar en el volumen persistente de Coolify.
DATA_FILE_PATH=./data/guests.json

# Hash Argon2id de la contraseña del administrador. Se genera con `npm run hash-password`
# (nunca la contraseña en texto plano). Va codificado como `base64:...` porque el hash contiene
# `$`, que los archivos .env interpretan como variable.
ADMIN_PASSWORD_HASH=

# Secreto aleatorio de al menos 32 caracteres para firmar las sesiones. Cambiarlo cierra todas
# las sesiones. Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Opcional: número de WhatsApp (con código de país, solo dígitos) para el botón «WhatsApp» de la
# invitación, p. ej. 573001234567. Si no se define, el botón no aparece.
WHATSAPP_NUMBER=

# Opcional: código de país (solo dígitos) que se antepone a los teléfonos de 10 dígitos sin prefijo
# cuando el panel envía una invitación por WhatsApp. Por defecto 57 (Colombia).
WHATSAPP_DEFAULT_COUNTRY_CODE=57
