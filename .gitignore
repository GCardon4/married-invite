# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# ideas of Design
/ideas

# error Logs in Deploy
/logs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# datos reales de invitados, temporales y respaldos (nunca en Git)
/data/*
!/data/.gitkeep
*.bak
*.tmp

# claves, certificados y credenciales (nunca en Git)
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.secret
credentials*.json
service-account*.json
secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
